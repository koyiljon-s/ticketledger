# Nothing here is required: concerts come from MusicBrainz, which needs no key.
# To use these settings, copy this file to .env.local and restart the dev server.

# Set to "true" to force sample data (e.g. an offline backup for a presentation).
EVENTS_USE_SAMPLE=false

# Contact URL or email sent to MusicBrainz in the User-Agent, which their API rules ask for.
MUSICBRAINZ_CONTACT=

# Optional, currently unused by any page: Ticketmaster Discovery API.
TICKETMASTER_API_KEY=
TICKETMASTER_USE_SAMPLE=false
