# Get a free key at https://developer.ticketmaster.com/ (My Apps → Consumer Key)
# Copy this file to .env.local and paste your key. Never commit .env.local.
# Without a key, the app runs in sample data mode (fictional events).
TICKETMASTER_API_KEY=

# Set to "true" to force sample data even when a key is set
# (e.g. an offline backup for a presentation).
TICKETMASTER_USE_SAMPLE=false
